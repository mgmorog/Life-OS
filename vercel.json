{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node build.mjs --target pwa",
  "outputDirectory": "dist-pwa",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth?x=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?x=prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/oauth?x=meta"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?x=meta"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/authorize.html"
    },
    {
      "source": "/cal/:token",
      "destination": "/api/cal?token=:token"
    },
    {
      "source": "/l/:token",
      "destination": "/share.html"
    }
  ],
  "headers": [
    {
      "source": "/authorize.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(app|shim)\\.(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}